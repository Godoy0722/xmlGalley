msgid "plugins.generic.xmlGalley.displayName"
msgstr "Плагин «XML-гранки»"

msgid "plugins.generic.xmlGalley.description"
msgstr "Этот плагин генерирует XHTML-гранки из статьи в формате XML, используя XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Использование этого плагина позволяет автоматически генерировать гранки статьи из исходного XML-файла,загруженного на сервер, используя указанное стилевое преобразование XSL.</p><p>Отключите плагин Lens Galley при использовании этого плагина, так как оба обрабатывают XML-гранки.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "Стилевая таблица XSL"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "NLM Journal Publishing DTD &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Пользовательская таблица стилей XSL"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Необходимо указать файл пользовательской таблицы стилей XSL."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "Загруженный файл XSL имеет неверный формат. Пожалуйста, проверьте файл и попробуйте снова."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Загрузить пользовательскую таблицу стилей XSL (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Текущая пользовательская таблица стилей: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Пожалуйста, выберите таблицу стилей XSL."
