msgid "plugins.generic.xmlGalley.displayName"
msgstr "Mòdul de galerades XML"

msgid "plugins.generic.xmlGalley.description"
msgstr "Aquest mòdul genera galerades XHTML d'articles XML mitjançant XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Si activeu aquest connector, les galerades dels articles es renderitzaran automàticament des d'un fitxer font XML carregat al lloc web mitjançant un full d'estil XSL específic.</p><p>Desactiveu el mòdul Lens Galley quan utilitzeu aquest mòdul, ja que tots dos gestionen galerades XML.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "Full d'estil XSL"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "NLM Publicació de la Revista DTD &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Full d'estil XSL personalitzat"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Heu d'indicar un full d'estil XSL personalitzat."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "El fitxer XSL que heu carregat no és vàlid. Comproveu el fitxer i torneu-ho a intentar."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Carregueu un full d'estil XSL personalitzat (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Full d'estil personalitzat actual: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Trieu un full d'estil XSL."
