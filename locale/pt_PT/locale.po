msgid "plugins.generic.xmlGalley.displayName"
msgstr "Plugin de Composição em XML"

msgid "plugins.generic.xmlGalley.description"
msgstr "Este plugin gera composições em XHTML de uma submissão em XML utilizando uma XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Com este plugin, composições da submissão serão automaticamente produzidas, a partir de um documento em XML, utilizando uma folha de estilos XSL para transformação.</p><p>Desative o plugin Lens Galley ao utilizar este plugin, pois ambos processam provas em XML.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "Folha de Estilos XSL"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "<a href=\"http://dtd.nlm.nih.gov/publishing/\">NLM Journal Publishing DTD</a> &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Folha de Estilo XSL Customizada"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Uma folha de estilos XSL deve ser especificada."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "O ficheiro XSL enviado não é válido. Verifique o documento e tente novamente."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Carregar uma Folha de Estilo XSL Customizada (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Folha de estilo customizada atual: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Escolha uma folha de estilo XSL."
