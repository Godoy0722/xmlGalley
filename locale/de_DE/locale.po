msgid "plugins.generic.xmlGalley.displayName"
msgstr "XML-Korrekturfassungen-Plug-In"

msgid "plugins.generic.xmlGalley.description"
msgstr "Dieses Plug-In erzeugt XHTML-Korrekturfassungen für XML-Artikel mittels XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Mit diesem Plug-In werden Artikel-Korrekturfassungen automatisch aus hochgeladenen XML-Dateien erstellt mittels XSLT.</p><p>Deaktivieren Sie das Lens-Galley-Plug-In, wenn Sie dieses Plug-In verwenden, da beide XML-Korrekturfassungen verarbeiten.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "XSL-Stylesheet"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "NLM Journal Publishing DTD &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "XSL-Stylesheet anpassen"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Eine XSL-Stylesheet-Datei muss spezifiziert werden."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "Die hochgeladene XSL-Datei war ungültig. Bitte prüfen Sie die Datei und versuchen Sie es dann noch einmal."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Eigenes XSL-Stylesheet hochladen (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Aktuelles eigenes Stylesheet: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Bitte wählen Sie ein XSL-Stylesheet."
