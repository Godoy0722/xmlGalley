msgid "plugins.generic.xmlGalley.displayName"
msgstr "إضافة لوح XML"

msgid "plugins.generic.xmlGalley.description"
msgstr "هذه الإضافة تنشئ ألواح XHTML من مقالة بصيغة XML باستعمال XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>بواسطة هذه الإضافة، ألواح المؤلَّف ستتم صناعتها آلياً من ملف مصدري مرفوع بصيغة XML عبر استعمال تحويل خاص من ملف أنماط XSL.</p><p>عطّل إضافة Lens Galley عند استعمال هذه الإضافة، لأن كلتيهما تعالجان ألواح XML.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "ملف أنماط XSL"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "<a href=\"http://dtd.nlm.nih.gov/publishing/\">NLM نشر المجلة DTD</a> &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "ملف أنماط XSL مخصص"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "ينبغي تحديد ملف أنماط مخصص بصيغة XSL."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "إن ملف الأنماط XSL لم يكن صحيحاً. لطفاً، تحقق من الملف ثم حاول مجدداً."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "رفع ملف أنماط XSL مخصص (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "ملف الأنماط المخصص الحالي: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "يرجى اختيار ملف أنماط XSL."
