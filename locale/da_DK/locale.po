msgid "plugins.generic.xmlGalley.displayName"
msgstr "XML korrektur plugin"

msgid "plugins.generic.xmlGalley.description"
msgstr "Dette plugin genererer XHTML korrekturer fra en XML artikel ved hjælp af XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Med dette plugin bliver korrekturversioner af artikler automatisk genereret fra en uploaded XML kilde ved hjælp af em særlig XSL stylesheet transformation.</p><p>Deaktiver Lens Galley-plugin, når du bruger dette plugin, da begge håndterer XML-korrekturer.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "XSL Stylesheet"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "<a href=\"http://dtd.nlm.nih.gov/publishing/\">NLM Journal Publishing DTD</a> → XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Standard XSL stylesheet"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "En standard XSL stylesheet fil skal angives."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "Den uploadede XSL fil var ugyldig. Check filen og prøv igen."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Upload et brugerdefineret XSL stylesheet (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Nuværende brugerdefinerede stylesheet: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Vælg et XSL stylesheet."
