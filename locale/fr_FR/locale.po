msgid "plugins.generic.xmlGalley.displayName"
msgstr "Plugiciel d'épreuve XML"

msgid "plugins.generic.xmlGalley.description"
msgstr "Ce plugiciel génère des épreuves XHTML à partir d'un article XML utilisant XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Ce plugiciel permet de traduire automatiquement les épreuves d'articles, à partir d'un fichier source XML téléchargé, en utilisant une transformation de feuille de style XSL spécifique.</p><p>Désactivez le module Lens Galley lorsque vous utilisez ce module, car les deux traitent les épreuves XML.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "Feuille de style XSL"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "<a href=\"http://dtd.nlm.nih.gov/publishing/\">Définition de type de document NLM pour l'édition de revues</a> &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Feuille de style XSL personnalisée"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Il faut spécifier un fichier de feuille de style XSL personnalisée."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "Le fichier XSL téléchargé n'était pas valide. Veuillez vérifier le fichier et essayer de nouveau."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Télécharger une feuille de style XSL personnalisée (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Feuille de style personnalisée actuelle : {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Veuillez choisir une feuille de style XSL."
