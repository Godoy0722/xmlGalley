msgid "plugins.generic.xmlGalley.displayName"
msgstr "Plugin XML sazebnice"

msgid "plugins.generic.xmlGalley.description"
msgstr "Tento plugin generuje XHTML sazebnice z XML článku s využitím XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>S tímto pluginem budou sazebnice článku automaticky renderovány z nahraného XML zdrojového souboru s použitím specifické XSL stylesheet transformace.</p><p>Při používání tohoto pluginu vypněte plugin Lens Galley, protože oba zpracovávají XML sazebnice.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "XSL soubor stylu"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "<a href=\"http://dtd.nlm.nih.gov/publishing/\">NLM Journal Publishing DTD</a> → XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Přizpůsobený XSL stylesheet"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Přizpůsobený soubor XSL stylesheet musí být specifikován."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "Nahraný soubor XSL nebyl platný. Zkontrolujte, prosím, soubor a zkuste to znovu."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Nahrát přizpůsobený XSL stylesheet (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Aktuální přizpůsobený stylesheet: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Vyberte prosím XSL soubor stylu."
