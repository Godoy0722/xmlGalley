msgid "plugins.generic.xmlGalley.displayName"
msgstr "Gabbie XML"

msgid "plugins.generic.xmlGalley.description"
msgstr "Questo plugin genera file XHTML a partire da un articolo XML usando XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Con questo plugin, le gabbie degli articoli saranno generate automaticamente a partire da un file sorgente XML, usando uno specifico foglio di stile di trasformazione XSL.</p><p>Disattiva il plugin Lens Galley quando usi questo plugin, perché entrambi gestiscono i file XML.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "Foglio di stile XSL"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "NLM Journal Publishing DTD &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Foglio di stile XSL personalizzato"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Un file del foglio di stile XSL personalizzato deve essere specificato."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "Il file XSL caricato non è valido. Si prega di controllare il file e riprovare."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Carica un foglio di stile XSL personalizzato (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Foglio di stile personalizzato attuale: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Scegli un foglio di stile XSL."
