msgid "plugins.generic.xmlGalley.displayName"
msgstr "Programutvidelse for XML korrekturutgave"

msgid "plugins.generic.xmlGalley.description"
msgstr "Denne programutvidelsen lager XHTML-korrekturutgaver av en XML-artikkel ved bruk av XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Med denne programutvidelsen blir korrekturutgaver av artiklene automatisk generert fra en opplastet XML kildefil, ved bruk av en spesifikk XSL stilarktransformering.</p><p>Deaktiver programutvidelsen Lens Galley når du bruker denne programutvidelsen, siden begge håndterer XML-korrekturutgaver.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "XSL-stilark"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "NLM Journal Publishing DTD &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Egendefinert XSL-stilark"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Et egendefinert XSL-stilark må angis."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "Den opplastede XSL-filen var ikke gyldig. Vennligst kontroller filen og prøv på nytt."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Last opp et egendefinert XSL-stilark (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Gjeldende egendefinerte stilark: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Velg et XSL-stilark."
