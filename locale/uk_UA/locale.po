msgid "plugins.generic.xmlGalley.displayName"
msgstr "Модуль гранок XML"

msgid "plugins.generic.xmlGalley.description"
msgstr "Цей модуль генерує гранки XHTML зі статей у форматі XML, використовуючи трансформацію XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Цей модуль дозволяє використання таблиць XSL для автоматичного рендерінгу гранок статей з вивантажених файлів з сирим XML-кодом.</p><p>Вимкніть модуль Lens Galley під час використання цього модуля, оскільки обидва обробляють гранки XML.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "Таблиця стилю XSL"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "NLM Journal Publishing DTD &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Власна таблиця стилю XSL"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Має бути визначений файл з власною таблицею стилю XSL."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "Вивантажений файл XSL не є коректним. Будь ласка, перевірте файл і спробуйте знову."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Завантажити власну таблицю стилю XSL (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Поточна власна таблиця стилю: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Будь ласка, оберіть таблицю стилю XSL."
