msgid "plugins.generic.xmlGalley.displayName"
msgstr "Plugin de Galerado XML"

msgid "plugins.generic.xmlGalley.description"
msgstr "Este plugin genera versiones galeradas XHTML a partir de un artículo XML usando XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Con este plugin, las versiones galeradas de los artículos serán automáticamente construidas a partir de un archivo fuente XML que se puede subir, usando una transformación especificada por una hoja de estilos XSL </p><p>Desactive el plugin Lens Galley cuando use este plugin, ya que ambos procesan versiones galeradas XML.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "Hoja de estilos XSL"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "NLM Journal Publishing DTD &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Personalizar la hoja de estilos XSL"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Un archivo de hoja de estilos XSL debe ser especificado."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "El archivo XSL subido no era válido. Por favor revíselo y vuelva a intentar."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Subir una hoja de estilos XSL personalizada (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Hoja de estilos personalizada actual: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Por favor elija una hoja de estilos XSL."
