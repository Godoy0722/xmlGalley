msgid "plugins.generic.xmlGalley.displayName"
msgstr "Módulo de galerada XML"

msgid "plugins.generic.xmlGalley.description"
msgstr "Este módulo genera galeradas XHTML de un artículo XML mediante XSLT."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Con este módulo, mediante una determinada transformación de la hoja de estilo XSL, las galeradas de un artículo se renderizarán de forma automática de un archivo fuente XML ya cargado.</p><p>Desactive el módulo Lens Galley al utilizar este módulo, ya que ambos gestionan galeradas XML.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "Hoja de estilo XSL"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "<a href=\"http://dtd.nlm.nih.gov/publishing/\">NLM Journal Publishing DTD</a> &rarr; XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Hoja de estilos XSL personalizada"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Debe indicar el archivo de hoja de estilos XSL personalizada."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "El archivo XSL cargado no es válido. Compruebe el archivo e inténtelo de nuevo."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Cargar una hoja de estilos XSL personalizada (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Hoja de estilos personalizada actual: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Seleccione una hoja de estilo XSL."
