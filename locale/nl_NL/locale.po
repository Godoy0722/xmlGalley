msgid "plugins.generic.xmlGalley.displayName"
msgstr "XML Galley Plugin"

msgid "plugins.generic.xmlGalley.description"
msgstr "Deze plugin genereert door middel van XSLT een XHTML proefdruk van een XML artikel."

msgid "plugins.generic.xmlGalley.settings.description"
msgstr "<p>Met deze plugin wordt met behulp van een specifieke XSL stylesheet proefdrukken van artikelen automatisch gegenereerd uit een XML bronbestand.</p><p>Schakel de Lens Galley-plugin uit wanneer u deze plugin gebruikt, omdat beide XML-proefdrukken verwerken.</p>"

msgid "plugins.generic.xmlGalley.settings.stylesheet"
msgstr "XSL Stylesheet"

msgid "plugins.generic.xmlGalley.settings.xslNLM"
msgstr "NLM Journal Publishing DTD → XHTML"

msgid "plugins.generic.xmlGalley.settings.customXSL"
msgstr "Eigen XSL stylesheet"

msgid "plugins.generic.xmlGalley.settings.customXSLRequired"
msgstr "Er moet een eigen XSL stylesheetbestand gespecificeerd worden."

msgid "plugins.generic.xmlGalley.settings.customXSLInvalid"
msgstr "Het opgegeven XSL bestand is niet correct. Controleer het bestand en probeer het opnieuw."

msgid "plugins.generic.xmlGalley.settings.customXSLUpload"
msgstr "Upload een eigen XSL stylesheet (.xsl)"

msgid "plugins.generic.xmlGalley.settings.customXSLCurrent"
msgstr "Huidige eigen stylesheet: {$fileName}"

msgid "plugins.generic.xmlGalley.settings.stylesheetRequired"
msgstr "Kies een XSL stylesheet."
