<?xml version="1.0" encoding="UTF-8"?>
<!--
	Article with a DOCTYPE pointing to the remote NLM DTD.
	Core XSLTransformer sets resolveExternals = true, so PHP fetches the DTD over
	the network on the first render: slow first view, or a failed fetch offline.
	Cached views after that are fast.
-->
<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Publishing DTD v2.3 20070202//EN" "http://dtd.nlm.nih.gov/publishing/2.3/journalpublishing.dtd">
<article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article">
	<front>
		<article-meta>
			<title-group><article-title>Article With a Remote DTD</article-title></title-group>
			<contrib-group>
				<contrib contrib-type="author"><name><surname>Doe</surname><given-names>Jane</given-names></name></contrib>
			</contrib-group>
		</article-meta>
	</front>
	<body>
		<sec>
			<title>Body</title>
			<p>Rendered after the DTD is resolved.</p>
		</sec>
	</body>
</article>
